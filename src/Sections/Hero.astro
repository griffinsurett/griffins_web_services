---
// src/Sections/Hero.astro
import { Image } from "astro:assets";
import Button from "../components/Buttons/Button.jsx";
import Heading from "../components/Heading.jsx";
import { siteData } from "../siteData";
import TestimonialCircleSection from "./TestimonialCircleSection.astro";
import ComputerGuy from "@/assets/computer-guy.png";

const heroTaglines = [
  {
    before: "Building ",
    emphasized: "Future-Ready",
    after: " Websites and Digital Solutions.",
  },
  {
    before: "Get a Website That ",
    emphasized: "Actually Sells",
    after: " for Your Business",
  },
  {
    before: "Build Your ",
    emphasized: "Digital Empire",
    after: " with Griffin's Web Services",
  },
  {
    before: "Leave Your Competition ",
    emphasized: "In the Dust",
    after: " with a Blazing Fast Website",
  },
  {
    before: "Your Business Deserves a ",
    emphasized: "Professional Website",
    after: " That Delivers.",
  },
  {
    before: "Boost Your Business with a ",
    emphasized: "Lightning-Fast",
    after: " Website",
  },
];

// Pick a random tagline (server-side)
const currentTagline = Math.floor(Math.random() * heroTaglines.length);
const tagline = heroTaglines[currentTagline];
---

<section class="min-h-screen bg-bg flex items-center justify-center relative overflow-hidden">
  {/* Background gradient */}
  <div class="absolute inset-0 hero-gradient-bg"></div>
  
  {/* Main content container */}
  <div class="relative z-10 min-h-screen inner-section flex">
    <!-- <div class="w-full flex flex-col xl:flex-row items-center justify-center"> -->
      
      {/* Left side - Text content (centered vertically) */}
      <div class="min-h-screen xl:h-auto inner-section mx-auto flex flex-col justify-center items-center">
        <div class="flex flex-col justify-left items-start lg:justify-center lg:items-center lg:text-center">
          
          {/* Main headline with emphasized text */}
          <Heading
            tagName="h1"
            className="text-4xl sm:text-5xl md:text-6xl lg:text-7xl mb-3 leading-tight"
            before={tagline.before}
            text={tagline.emphasized}
            textClass="emphasized-text"
            after={tagline.after}
          />
          
          {/* Longer, more detailed description */}
          <p class="text-text mb-4 text-lg lg:text-xl max-w-3xl leading-relaxed">
            We specialize in crafting scalable, secure, and AI-optimized digital experiences. 
            From responsive websites and dynamic data platforms to AI and seamless 
            automations—so you can focus on growing your business while we handle the 
            technology.
          </p>

          <div class="flex flex-col lg:flex-row items-center gap-6">
              <Button variant="secondary" href="#contact" client:visible>
                Book An Intro Call
              </Button>

                          {/* Testimonial circles */}
            <TestimonialCircleSection />
            
          </div>
        </div>
      </div>
      
      {/* Right side - Taller Image (hugging bottom) */}
      <!-- <div class="flex relative h-full">
        <div class="xl:absolute bottom-0 right-0 w-full h-auto flex justify-end pl-20 lg:pl-30 xl:pl-40">
          <Image
            src={ComputerGuy}
            alt="Professional web developer working on laptop"
            class="h-full w-auto object-contain object-bottom"
            fetchpriority="high"
            loading="eager"
          />
        </div>
      </div> -->
      
    <!-- </div> -->
  </div>
</section>