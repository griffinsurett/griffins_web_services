---
// src/pages/index.astro - Main homepage
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/sections/Header.astro";
import About from "../components/sections/About.astro";
import Benefits from "../components/sections/Benefits.astro";
import WebsiteTypesSection from "../components/sections/WebsiteTypesSection.astro";
import HostingMaintenance from "../components/sections/HostingMaintenance.astro";
import AddOnServices from "../components/sections/AddOnServices.astro";
import PortfolioSection from "../components/sections/PortfolioSection.astro";
import Testimonials from "../components/sections/TestimonialsSection.astro";
import TechStackSection from "../components/sections/TechStackSection.astro";
import FAQ from "../components/sections/FAQ.astro";
import QuoteFormSection from "../components/sections/QuoteFormSection.astro";
import CTASection from "../components/sections/CTASection.astro";
import Stats from "../components/sections/Stats.astro";
import Footer from "../components/sections/Footer.astro";
// import HeroBasic from "../Sections/HeroBasic.astro";
import { siteData } from "@/siteData";
import Hero from "@/components/sections/Hero.astro";
---

<BaseLayout
  title={`Professional Website Development Services`}
  description="Get a lightning-fast, secure, and mobile-first website that converts visitors into customers. Professional web development, hosting, and maintenance services."
  ;
  ogType="website"
>
  <Header />

  <main id="main-content" class="relative">
    <!-- Hero Section -->
    <Hero />
    <!-- <HeroBasic /> -->

    <!-- Core Services -->
    <About />
    <Benefits />
    <WebsiteTypesSection />

    <!-- Portfolio & Social Proof -->
    <PortfolioSection />
    <Testimonials />

    <!-- CTA & Trust Signals -->
    <CTASection />
    <Stats />

    <!-- Technical & Services -->
    <TechStackSection />
    <HostingMaintenance />
    <AddOnServices />

    <!-- Support & Contact -->
    <FAQ />
    <QuoteFormSection />
  </main>

  <Footer />
</BaseLayout>
